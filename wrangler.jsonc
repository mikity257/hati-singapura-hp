{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hati-singapura",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "MEMBERS_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
